# No provider key required for core demo. Never commit secrets.
DEMO_MODE=true
# Optional checkup chat LLM (OpenRouter preferred, Gemini secondary):
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional phone intake (ElevenLabs ConvAI + Twilio number):
# ELEVENLABS_API_KEY=
# ELEVENLABS_PHONE_NUMBER_ID=
# ELEVENLABS_AGENT_ID=
# Voice STT/TTS is optional and server-only. Use the secret API key, not its key ID.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Run: python setup_voice_agent.py
# APP_ORIGINS=https://your-authorized-demo.example
# Public Railway/demo hosting (no login gate):
# APP_ENV=production
# COOKIE_SECURE=true
