# No provider key required for core demo. Never commit secrets.
DEMO_MODE=true
# Optional checkup chat LLM (OpenRouter preferred, Gemini secondary):
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# ELEVENLABS_API_KEY=
# Integration server reads exported environment variables; .env is not auto-loaded.
# Voice is optional and server-only. Use the secret API key, not its key ID.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# APP_ORIGINS=https://your-authorized-demo.example
# Production requires private demo access (browser Basic auth, username demo):
# APP_ENV=production
# DEMO_ACCESS_TOKEN=
# COOKIE_SECURE=true
